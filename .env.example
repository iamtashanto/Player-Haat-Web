# PlayerHaat Web — Environment Configuration

# Backend REST API base URL (Express + PostgreSQL + Prisma)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public site URL (used for canonical URLs, sitemap, and Open Graph images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Identity Services Web Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Sign in with Apple Web Service ID
NEXT_PUBLIC_APPLE_CLIENT_ID=

# Cloudinary Cloud Name for optimized player photos
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Optional Sentry DSN & Privacy-friendly Analytics
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

