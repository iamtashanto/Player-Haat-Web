# PlayerHaat Website Environment Configuration

# Public API URL (Express + PostgreSQL + Prisma REST API)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public Website Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Social Auth Credentials (Web)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_APPLE_CLIENT_ID=com.playerhaat.web
NEXT_PUBLIC_APPLE_REDIRECT_URI=https://playerhaat.com/api/auth/apple/callback

# Optional Monitoring & Analytics
# NEXT_PUBLIC_SENTRY_DSN=
